/* ============================================================
   臻瓷汇 · 全局样式
   基础框架：ColorUI v2.1.4（colorui/main.wxss + icon.wxss）
   本文件在 ColorUI 之上叠加「深色 + 金色」主题与业务组件类
   ============================================================ */
@import "colorui/main.wxss";
@import "colorui/icon.wxss";
@import "colorui/animation.wxss";

/* ---------- 主题变量（覆盖 ColorUI 默认配色） ---------- */
page {
  /* 覆盖 ColorUI 的浅色底色与主色 */
  --white: #16161d;
  --ghostWhite: #0c0c11;
  --black: #efe9dc;
  --darkGray: #8f8a80;
  --gray: #5f5b54;
  --primary: #c9a26b;

  /* 业务色板 */
  --bg: #0c0c11;
  --card: #16161d;
  --card2: #1c1c25;
  --line: rgba(235, 225, 205, 0.10);
  --ink: #efe9dc;
  --sub: #8f8a80;
  --dim: #5f5b54;
  --gold: #c9a26b;
  --gold2: #e7d2a4;
  --danger: #e0684f;
  --gold-grad: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);

  background-color: #0c0c11;
  color: #efe9dc;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

view, text, input, textarea, button, image, scroll-view {
  box-sizing: border-box;
}

/* ---------- 文字 ---------- */
.tc-serif { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; }
.tc-gold { color: #e7d2a4; }
.tc-sub { color: #8f8a80; }
.tc-dim { color: #5f5b54; }
.tc-danger { color: #e0684f; }
.tc-mono { font-family: ui-monospace, Menlo, Consolas, monospace; letter-spacing: 2rpx; }
.tc-en { font-size: 18rpx; letter-spacing: 6rpx; color: #c9a26b; }
.tc-bold { font-weight: 700; }
.tc-ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.tc-clamp2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------- 页面容器 ---------- */
.tc-page {
  min-height: 100vh;
  background-color: #0c0c11;
}
.tc-pad { padding: 28rpx; }
.tc-divider { height: 1rpx; background: rgba(235, 225, 205, 0.10); }

/* ---------- 卡片 ---------- */
.tc-card {
  background-color: #16161d;
  border: 1rpx solid rgba(235, 225, 205, 0.10);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.tc-card-hd {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 26rpx;
}
.tc-card-hd::before {
  content: "";
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  margin-right: 16rpx;
}
.tc-sec {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #c9c4b8;
  margin: 36rpx 4rpx 20rpx;
}
.tc-sec::before {
  content: "";
  width: 6rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  margin-right: 16rpx;
}

/* ---------- 金色 Hero（管理后台头部） ---------- */
.tc-hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 36rpx;
  border-radius: 32rpx;
  margin-bottom: 28rpx;
  background: linear-gradient(130deg, #2b2416 0%, #191510 55%, #100e0a 100%);
  border: 1rpx solid rgba(201, 162, 107, 0.4);
}
.tc-hero::before {
  content: "";
  position: absolute;
  right: -110rpx;
  top: -110rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(231, 210, 164, 0.15), transparent 65%);
}
.tc-hero-k { font-size: 18rpx; letter-spacing: 8rpx; color: #c9a26b; margin-bottom: 18rpx; }
.tc-hero-title { font-size: 38rpx; letter-spacing: 6rpx; color: #e7d2a4; }
.tc-hero-desc { font-size: 22rpx; color: #8f8a80; margin-top: 16rpx; line-height: 1.8; letter-spacing: 1rpx; }

/* ---------- 按钮 ---------- */
.tc-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 44rpx;
  border: none;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  color: #231a0c;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  line-height: 1;
}
.tc-btn::after { border: none; }
.tc-btn.tc-btn-block { width: 100%; }
.tc-btn.hover, .tc-btn.button-hover { filter: brightness(0.92); }
.tc-btn[disabled], .tc-btn.tc-disabled {
  background: #2a2a33;
  color: #5f5b54;
  box-shadow: none;
}

.tc-btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 26rpx;
  border: 1rpx solid rgba(235, 225, 205, 0.10);
  border-radius: 14rpx;
  background: transparent;
  color: #8f8a80;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1;
}
.tc-btn-ghost::after { border: none; }
.tc-btn-ghost.hover { color: #e7d2a4; border-color: rgba(201, 162, 107, 0.4); }

.tc-btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 26rpx;
  border: 1rpx solid rgba(224, 104, 79, 0.4);
  border-radius: 14rpx;
  background: transparent;
  color: #d98a77;
  font-size: 24rpx;
  line-height: 1;
}
.tc-btn-danger::after { border: none; }
.tc-btn-danger.hover { background: rgba(224, 104, 79, 0.1); }

/* ---------- 表单 ---------- */
.tc-fcol { display: flex; flex-direction: column; }
.tc-fcol > .tc-input,
.tc-fcol > .tc-picker,
.tc-fcol > .tc-textarea,
.tc-fcol > .tc-btn { margin-bottom: 18rpx; }
.tc-frow { display: flex; align-items: center; }
.tc-label { font-size: 24rpx; color: #8f8a80; letter-spacing: 2rpx; }
.tc-input,
.tc-textarea,
.tc-picker {
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(235, 225, 205, 0.16);
  border-radius: 18rpx;
  background-color: #0d0d13;
  color: #efe9dc;
  font-size: 26rpx;
}
.tc-input { height: 88rpx; }
.tc-textarea { min-height: 160rpx; line-height: 1.7; }
.tc-picker { display: flex; align-items: center; justify-content: space-between; }
.tc-picker .ph { color: #5f5b54; }
.tc-input-ph { color: #5f5b54; }

/* ---------- 标签 ---------- */
.tc-tag {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(201, 162, 107, 0.5);
  color: #e7d2a4;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  white-space: nowrap;
}
.tc-tag.is-dim { border-color: rgba(143, 138, 128, 0.4); color: #8f8a80; }
.tc-tag.is-on { border-color: rgba(127, 216, 164, 0.35); color: #7fd8a4; }
.tc-tag.is-off { border-color: rgba(143, 138, 128, 0.4); color: #8f8a80; }
.tc-tag.is-danger { border-color: rgba(224, 104, 79, 0.4); color: #d98a77; }
.tc-tag.is-solid {
  border: none;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  color: #231a0c;
  height: 40rpx;
}

/* ---------- 管理端列表卡片 ---------- */
.tc-item {
  background-color: #16161d;
  border: 1rpx solid rgba(235, 225, 205, 0.10);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
}
.tc-item-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tc-item-title { font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.tc-item-meta { font-size: 22rpx; color: #5f5b54; font-family: ui-monospace, Menlo, monospace; margin-top: 8rpx; }
.tc-item-trace { font-size: 22rpx; color: #8f8a80; line-height: 1.7; margin-top: 14rpx; }
.tc-item-trace .hl { color: #b9b3a6; font-weight: 600; }
.tc-item-ops {
  display: flex;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(235, 225, 205, 0.10);
}
.tc-item-ops > view, .tc-item-ops > button { flex: 1; }
.tc-item-ops > view + view, .tc-item-ops > button + button, .tc-item-ops > view + button { margin-left: 18rpx; }

/* ---------- 圆形品牌标识 ---------- */
.tc-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: linear-gradient(135deg, #2b2416, #16130d);
  border: 1rpx solid rgba(201, 162, 107, 0.45);
  color: #e7d2a4;
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 800;
}

/* ---------- 缩略图 ---------- */
.tc-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background-color: #222228;
}

/* ---------- 骨架/空态/加载 ---------- */
.tc-empty {
  text-align: center;
  color: #5f5b54;
  font-size: 25rpx;
  letter-spacing: 4rpx;
  padding: 120rpx 0;
}
.tc-loading {
  text-align: center;
  color: #5f5b54;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  padding: 100rpx 0;
}

/* ---------- 进度条 ---------- */
.tc-bar {
  height: 10rpx;
  border-radius: 6rpx;
  background-color: rgba(235, 225, 205, 0.08);
  overflow: hidden;
}
.tc-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  transition: width 0.6s cubic-bezier(0.2, 0.7, 0.3, 1);
}

/* ---------- 两列宫格 ---------- */
.tc-grid2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-gap: 22rpx;
}

/* ---------- 未开通会员锁定页 ---------- */
.tc-lock {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 84rpx 0;
  text-align: center;
}
.tc-lock-ic {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(201, 162, 107, 0.4);
  color: #c9a26b;
  font-size: 56rpx;
  margin-bottom: 40rpx;
}
.tc-lock-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}
.tc-lock-desc { font-size: 25rpx; color: #8f8a80; line-height: 2; margin-bottom: 52rpx; }

/* ---------- 价格 ---------- */
.tc-price { font-family: "Songti SC", "STSong", serif; color: #e7d2a4; font-weight: 800; }
.tc-price .unit { font-family: -apple-system, sans-serif; font-size: 22rpx; font-weight: 400; color: #8f8a80; }

/* ---------- 图片等比容器（16:9 / 1:1） ---------- */
.tc-ratio {
  position: relative;
  width: 100%;
  overflow: hidden;
  background-color: #16161d;
}
.tc-ratio-169 { padding-top: 56.25%; }
.tc-ratio-11 { padding-top: 100%; }
.tc-ratio > image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* ---------- 底部安全区 ---------- */
.tc-safe { height: calc(40rpx + env(safe-area-inset-bottom)); }
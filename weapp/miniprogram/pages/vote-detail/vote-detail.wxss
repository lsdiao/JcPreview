.gallery {
  position: relative;
  width: 100%;
  height: 460rpx;
  background-color: #16161d;
}
.swiper { width: 100%; height: 100%; }
.swiper image { width: 100%; height: 100%; }
.counter {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  height: 46rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #e7d2a4;
  font-size: 21rpx;
  font-family: ui-monospace, Menlo, monospace;
  display: flex;
  align-items: center;
}
.state {
  position: absolute;
  left: 28rpx;
  bottom: 28rpx;
  height: 46rpx;
  padding: 0 22rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.55);
  border: 1rpx solid rgba(143, 138, 128, 0.5);
  color: #8f8a80;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.state.on {
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  border-color: transparent;
  color: #1d1608;
}

.body { padding: 34rpx 36rpx 40rpx; }
.title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: 1rpx;
}
.meta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8f8a80;
}
.m-num {
  color: #e7d2a4;
  font-family: ui-monospace, Menlo, monospace;
  font-size: 30rpx;
  font-weight: 700;
  margin-right: 8rpx;
}
.meta .dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #454239;
  margin: 0 14rpx;
}
.intro {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #a39e93;
  line-height: 1.9;
}

/* 选项 */
.opt {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 18rpx;
  border-radius: 20rpx;
  background-color: #16161d;
  border: 1rpx solid rgba(235, 225, 205, 0.12);
}
.opt-hover { border-color: rgba(201, 162, 107, 0.5); }
.opt.is-result {
  display: block;
  min-height: 0;
  padding: 26rpx 28rpx 28rpx;
}

.radio {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 1rpx solid rgba(235, 225, 205, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #231a0c;
  font-size: 30rpx;
  margin-right: 22rpx;
}
.radio.on {
  border-color: transparent;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
}

.opt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.opt-text {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #efe9dc;
  flex: 1;
  min-width: 0;
}
.opt-idx { line-height: 1.5; }
.opt-mine {
  margin-left: 16rpx;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  border: 1rpx solid rgba(201, 162, 107, 0.5);
  color: #e7d2a4;
  font-size: 20rpx;
  flex-shrink: 0;
}
.opt-num { text-align: right; flex-shrink: 0; margin-left: 20rpx; }
.opt-pct {
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 800;
  color: #e7d2a4;
}
.opt-cnt {
  display: block;
  font-size: 20rpx;
  color: #5f5b54;
  margin-top: 6rpx;
}

.done-tip {
  font-size: 21rpx;
  color: #5f5b54;
  line-height: 1.9;
  margin-top: 10rpx;
}

.mt { margin-top: 26rpx; }

.note {
  margin-top: 44rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(235, 225, 205, 0.10);
  font-size: 21rpx;
  color: #5f5b54;
  line-height: 1.9;
}
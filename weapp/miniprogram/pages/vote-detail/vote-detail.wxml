<!-- 投票详情 · 会员投票 / 结果公示，可分享到群和朋友圈 -->
<view class="tc-page">
  <block wx:if="{{loading}}">
    <view class="tc-loading">加载中…</view>
  </block>

  <block wx:elif="{{vote}}">
    <!-- 头图 -->
    <view class="gallery" wx:if="{{vote.images.length}}">
      <swiper
        class="swiper"
        circular="{{vote.images.length > 1}}"
        bindchange="onSwiper"
      >
        <swiper-item wx:for="{{vote.images}}" wx:key="index">
          <image src="{{item}}" mode="aspectFill"></image>
        </swiper-item>
      </swiper>
      <view class="counter" wx:if="{{vote.images.length > 1}}">{{current}} / {{vote.images.length}}</view>
      <view class="state {{vote.doing ? 'on' : ''}}">{{vote.doing ? '进行中' : '已结束'}}</view>
    </view>

    <view class="body">
      <view class="title">{{vote.title}}</view>
      <view class="meta">
        <text class="m-num">{{total}}</text>
        <text>人已参与</text>
        <text class="dot"></text>
        <text>{{vote.deadlineText}}</text>
      </view>
      <view class="intro" wx:if="{{vote.intro}}">{{vote.intro}}</view>

      <!-- 选项 -->
      <view class="tc-sec">{{hasVoted || !vote.doing ? '投票结果' : '请选择一个选项'}}</view>

      <block wx:if="{{hasVoted || !vote.doing}}">
        <!-- 结果视图 -->
        <view class="opt is-result" wx:for="{{opts}}" wx:key="index">
          <view class="opt-row">
            <view class="opt-text">
              <text class="opt-idx">{{item.text}}</text>
              <text class="opt-mine" wx:if="{{vote.myOption === index}}">我投的</text>
            </view>
            <view class="opt-num">
              <text class="opt-pct">{{item.percent}}%</text>
              <text class="opt-cnt">{{item.count}} 票</text>
            </view>
          </view>
          <view class="tc-bar">
            <view
              class="tc-bar-fill"
              style="width: {{item.percent}}%; {{vote.myOption === index ? '' : 'opacity: 0.55;'}}"
            ></view>
          </view>
        </view>

        <view class="done-tip" wx:if="{{hasVoted}}">你已完成投票，每人限投一票，不可改票</view>
        <view class="done-tip" wx:else>投票已于 {{vote.deadlineText}} 结束，结果仅供参考</view>
      </block>

      <block wx:else>
        <!-- 可选视图 -->
        <view
          class="opt"
          wx:for="{{opts}}"
          wx:key="index"
          data-index="{{index}}"
          bindtap="pick"
          hover-class="opt-hover"
        >
          <view class="radio {{picking === index ? 'on' : ''}}">
            <text class="cuIcon-roundcheckfill" wx:if="{{picking === index}}"></text>
          </view>
          <view class="opt-text">{{item.text}}</view>
        </view>
      </block>

      <!-- 提交 -->
      <view
        class="tc-btn tc-btn-block mt {{(!vote.doing || hasVoted || submitting) ? 'tc-disabled' : ''}}"
        wx:if="{{vote.doing && !hasVoted}}"
        bindtap="submit"
      >
        {{submitting ? '提交中…' : '提交投票'}}
      </view>

      <view class="tc-btn-ghost mt" wx:if="{{!isMember}}" bindtap="goActivate">开通会员后参与投票</view>

      <view class="note">
        会员每人限投一票，不可改票。分享到朋友圈打开时为单页模式，需进入小程序参与投票。
      </view>

      <!-- 分享 -->
      <button class="tc-btn tc-btn-block mt" open-type="share">分享到微信群</button>
    </view>

    <view class="tc-safe"></view>
  </block>

  <view class="tc-empty" wx:else>投票不存在或已被删除</view>
</view>
.mt { margin-top: 20rpx; }

.hint {
  margin-top: 20rpx;
  font-size: 21rpx;
  color: #5f5b54;
  line-height: 1.9;
  letter-spacing: 1rpx;
}

.res {
  display: flex;
  padding: 4rpx 0 22rpx;
}
.res-hover { opacity: 0.85; }
.res-img {
  width: 170rpx;
  height: 170rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  background-color: #222228;
  display: flex;
  align-items: center;
  justify-content: center;
}
.res-img image { width: 100%; height: 100%; }
.res-img .is-ph { color: #454239; font-size: 48rpx; }
.res-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}
.res-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}
.res-sub {
  font-size: 22rpx;
  color: #8f8a80;
  margin-top: 12rpx;
}
.res-no {
  font-size: 21rpx;
  color: #5f5b54;
  margin-top: 8rpx;
}

.price-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(130deg, rgba(43, 36, 22, 0.9), rgba(16, 14, 10, 0.9));
  border: 1rpx solid rgba(201, 162, 107, 0.35);
}
.pb-label {
  font-size: 22rpx;
  color: #c9a26b;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}
.pb-num { font-size: 60rpx; line-height: 1; }
.pb-num .unit { font-size: 22rpx; margin-left: 6rpx; }

.fail {
  text-align: center;
  padding: 56rpx 30rpx;
}
.fail-ic { color: #d98a77; font-size: 64rpx; }
.fail-txt {
  font-size: 28rpx;
  margin-top: 24rpx;
  color: #efe9dc;
  letter-spacing: 1rpx;
}
.fail-sub {
  font-size: 22rpx;
  color: #5f5b54;
  margin-top: 16rpx;
  line-height: 1.8;
}
.me {
  display: flex;
  align-items: center;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: #222228;
}
.avatar.is-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5f5b54;
  font-size: 48rpx;
  border: 1rpx solid rgba(235, 225, 205, 0.12);
}
.me-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.me-name {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.me-sub {
  font-size: 22rpx;
  color: #8f8a80;
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

.nick-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}
.avatar-btn {
  width: 88rpx !important;
  height: 88rpx;
  padding: 0;
  margin: 0 18rpx 0 0;
  border-radius: 50%;
  background-color: #0d0d13;
  border: 1rpx solid rgba(235, 225, 205, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8f8a80;
  font-size: 38rpx;
  line-height: 1;
  flex-shrink: 0;
}
.avatar-btn::after { border: none; }
.avatar-sm {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}
.nick-input { flex: 1; min-width: 0; }

.code-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}
.code-input {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}
.scan-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 88rpx;
  border: 1rpx solid rgba(201, 162, 107, 0.4);
  border-radius: 18rpx;
  background-color: #0d0d13;
  color: #c9a26b;
  flex-shrink: 0;
}
.scan-btn .cuIcon-scan {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}
.scan-btn text:last-child {
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.hint {
  margin-top: 20rpx;
  font-size: 21rpx;
  color: #5f5b54;
  line-height: 1.9;
}

.lv-row {
  display: flex;
}
.lv-cell {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border: 1rpx solid rgba(235, 225, 205, 0.10);
  border-radius: 18rpx;
  background-color: #0d0d13;
}
.lv-cell + .lv-cell { margin-left: 16rpx; }
.lv-cell.on {
  border-color: rgba(201, 162, 107, 0.65);
  background: linear-gradient(135deg, rgba(236, 217, 172, 0.12), rgba(169, 127, 76, 0.06));
}
.lv-name { font-size: 25rpx; font-weight: 600; letter-spacing: 1rpx; }
.lv-cell.on .lv-name { color: #e7d2a4; }
.lv-desc { font-size: 20rpx; color: #5f5b54; margin-top: 10rpx; }

.cell {
  display: flex;
  align-items: center;
  min-height: 96rpx;
}
.cell + .cell { border-top: 1rpx solid rgba(235, 225, 205, 0.10); }
.cell-hover { background-color: rgba(235, 225, 205, 0.04); }
.cell-ic { color: #c9a26b; font-size: 36rpx; margin-right: 20rpx; }
.cell-name { flex: 1; font-size: 28rpx; letter-spacing: 1rpx; }
.cell-sub { font-size: 22rpx; color: #5f5b54; }
.cell-arrow { color: #454239; font-size: 28rpx; margin-left: 12rpx; }

.ver {
  text-align: center;
  font-size: 21rpx;
  color: #454239;
  letter-spacing: 2rpx;
  margin-top: 40rpx;
}

/* ---------- 专属顾问弹框 ---------- */
.consultant-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 80rpx;
}
.consultant-modal {
  width: 100%;
  background: linear-gradient(160deg, #2b2416 0%, #191510 60%, #100e0a 100%);
  border: 1rpx solid rgba(201, 162, 107, 0.4);
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  position: relative;
  text-align: center;
}
.consultant-modal-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  color: #e7d2a4;
  letter-spacing: 8rpx;
  margin-bottom: 8rpx;
}
.consultant-modal-name {
  font-size: 24rpx;
  color: #c9a26b;
  letter-spacing: 4rpx;
  margin-bottom: 28rpx;
}
.consultant-modal-qrcode {
  width: 380rpx;
  height: 380rpx;
  border-radius: 20rpx;
  background-color: #fff;
  padding: 16rpx;
}
.consultant-modal-tip {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #8f8a80;
  letter-spacing: 2rpx;
}
.consultant-modal-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5f5b54;
  font-size: 28rpx;
}
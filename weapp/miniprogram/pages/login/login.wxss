.login-page {
  min-height: 100vh;
  background-color: #0c0c11;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx;
}

.login-hero {
  padding-top: 160rpx;
  text-align: center;
  margin-bottom: 80rpx;
}
.login-logo {
  font-family: "Songti SC", "STSong", serif;
  font-size: 52rpx;
  color: #e7d2a4;
  letter-spacing: 12rpx;
  margin-bottom: 16rpx;
}
.login-en {
  font-size: 18rpx;
  letter-spacing: 10rpx;
  color: #c9a26b;
  margin-bottom: 20rpx;
}
.login-slogan {
  font-size: 24rpx;
  color: #8f8a80;
  letter-spacing: 4rpx;
}

.login-card {
  background-color: #16161d;
  border: 1rpx solid rgba(235, 225, 205, 0.10);
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
}

.login-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #8f8a80;
  margin-bottom: 32rpx;
  letter-spacing: 1rpx;
}
.login-tip-ic {
  color: #c9a26b;
  font-size: 32rpx;
  margin-right: 12rpx;
}

.login-btn {
  margin-bottom: 28rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #5f5b54;
}
.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 1rpx solid rgba(235, 225, 205, 0.25);
  border-radius: 6rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.checkbox.checked {
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  border-color: transparent;
}
.checkbox .cuIcon-right {
  color: #231a0c;
  font-size: 22rpx;
  font-weight: 800;
}
.agree-text {
  line-height: 1.6;
}
.agree-link {
  color: #c9a26b;
}

.skip-row {
  margin-top: 24rpx;
  text-align: center;
}
.skip-btn {
  font-size: 22rpx;
  color: #5f5b54;
  letter-spacing: 2rpx;
}

.login-footer {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 60rpx;
  font-size: 20rpx;
  color: #454239;
  letter-spacing: 2rpx;
}

/* 隐私协议弹窗 */
.privacy-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
}
.privacy-modal {
  width: 100%;
  max-height: 80vh;
  background-color: #16161d;
  border: 1rpx solid rgba(235, 225, 205, 0.12);
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.privacy-title {
  padding: 32rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #e7d2a4;
  letter-spacing: 4rpx;
  border-bottom: 1rpx solid rgba(235, 225, 205, 0.08);
}
.privacy-body {
  flex: 1;
  padding: 28rpx 32rpx;
  max-height: 60vh;
}
.privacy-sec {
  font-size: 26rpx;
  font-weight: 700;
  color: #c9a26b;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}
.privacy-sec:first-child { margin-top: 0; }
.privacy-p {
  font-size: 24rpx;
  color: #b9b3a6;
  line-height: 1.9;
  letter-spacing: 1rpx;
}
.privacy-footer {
  padding: 24rpx 32rpx 32rpx;
  border-top: 1rpx solid rgba(235, 225, 205, 0.08);
}

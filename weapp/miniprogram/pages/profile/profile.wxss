.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 36rpx;
  padding-bottom: 36rpx;
}

.profile-avatar-row {
  margin-bottom: 28rpx;
}
.profile-avatar-btn {
  width: 160rpx !important;
  height: 160rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  position: relative;
  line-height: 1;
}
.profile-avatar-btn::after { border: none; }
.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #222228;
}
.profile-avatar.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #0d0d13;
  border: 1rpx solid rgba(235, 225, 205, 0.12);
  color: #5f5b54;
  font-size: 64rpx;
}
.profile-avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #231a0c;
  font-size: 24rpx;
}

.profile-nick-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: 12rpx;
}
.profile-label {
  font-size: 26rpx;
  color: #8f8a80;
  letter-spacing: 2rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  width: 100rpx;
}
.profile-input {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 28rpx;
  color: #efe9dc;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
}
.info-row + .info-row {
  border-top: 1rpx solid rgba(235, 225, 205, 0.08);
}
.info-label {
  font-size: 26rpx;
  color: #8f8a80;
  letter-spacing: 2rpx;
}
.info-value {
  font-size: 26rpx;
  color: #efe9dc;
  max-width: 60%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.info-dim { color: #5f5b54; }
.info-openid { font-size: 22rpx; }

.info-edit .info-input {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 26rpx;
  color: #efe9dc;
  background: transparent;
  padding: 0;
}

/* 产品编辑页 */

.bottom-ops {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(15, 14, 12, 0.95);
  backdrop-filter: blur(20px);
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid rgba(201, 162, 107, 0.15);
  z-index: 100;
}

.bop {
  flex: 1;
  margin: 0;
}

/* 页面底部留出操作栏空间 */
.tc-safe {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.tc-page { padding-bottom: 0; }

/* 两列布局 */
.two { display: flex; gap: 20rpx; }
.two-c { flex: 1; min-width: 0; }

/* 价格行 */
.price-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}
.price-c {
  flex: 1;
  min-width: 0;
}
.price-lab {
  font-size: 22rpx;
  color: #5f5b54;
  margin-bottom: 8rpx;
  text-align: center;
}
.price-in {
  text-align: center;
  font-size: 28rpx;
}

/* 图片九宫格 */
.img-grid { display: flex; flex-wrap: wrap; }
.img-cell {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #222228;
}
.img-cell image { width: 100%; height: 100%; }
.img-cell.is-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #0d0d13;
  border: 1rpx dashed rgba(235, 225, 205, 0.24);
  color: #5f5b54;
  font-size: 52rpx;
}
.img-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  color: #e0684f;
  font-size: 28rpx;
  border-bottom-left-radius: 16rpx;
}

/* 开关行 */
.sw-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid rgba(235, 225, 205, 0.10);
}
.sw-name { font-size: 27rpx; }
.sw-desc { font-size: 21rpx; color: #5f5b54; margin-top: 8rpx; }

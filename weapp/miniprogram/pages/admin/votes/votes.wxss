.bar { display: flex; margin-bottom: 26rpx; }
.bar-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  color: #231a0c;
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.bar-txt { margin-left: 12rpx; }

.fl-label {
  font-size: 24rpx;
  color: #8f8a80;
  letter-spacing: 1rpx;
  margin: 26rpx 4rpx 14rpx;
}
.fl-label .req { color: #d98a77; font-size: 21rpx; margin-left: 8rpx; }

.hint {
  font-size: 21rpx;
  color: #5f5b54;
  line-height: 1.9;
  margin-top: 18rpx;
}

/* 图片 */
.img-grid { display: flex; flex-wrap: wrap; }
.img-cell {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #222228;
}
.img-cell image { width: 100%; height: 100%; }
.img-cell.is-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #0d0d13;
  border: 1rpx dashed rgba(235, 225, 205, 0.24);
  color: #5f5b54;
  font-size: 52rpx;
}
.img-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  color: #e0684f;
  font-size: 28rpx;
  border-bottom-left-radius: 16rpx;
}

/* 选项编辑 */
.opt-edit {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.opt-idx {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #c9a26b;
  font-family: ui-monospace, Menlo, monospace;
}
.opt-in { flex: 1; min-width: 0; }
.opt-del {
  width: 60rpx;
  text-align: center;
  color: #8f8a80;
  font-size: 32rpx;
}
.add-opt { margin-top: 6rpx; }

/* 截止时间 */
.deadline { display: flex; align-items: center; }
.dl-picker { flex: 1; min-width: 0; }
.dl-clear { margin-left: 16rpx; }

.form-ops { display: flex; margin-top: 30rpx; }
.fop { flex: 1; }
.fop + .fop { margin-left: 20rpx; }

/* 列表 */
.vt { flex: 1; min-width: 0; font-size: 29rpx; font-weight: 600; line-height: 1.5; }

.res-list { margin-top: 22rpx; }
.res-r { margin-bottom: 18rpx; }
.res-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.res-t { font-size: 24rpx; color: #cfc9bd; flex: 1; min-width: 0; }
.res-n {
  font-size: 21rpx;
  color: #8f8a80;
  flex-shrink: 0;
  margin-left: 16rpx;
  font-family: ui-monospace, Menlo, monospace;
}

.tc-item-ops.wrap { flex-wrap: wrap; }
.tc-item-ops.wrap > view {
  flex: none;
  width: calc((100% - 18rpx) / 2);
  margin-left: 0;
  margin-bottom: 16rpx;
}
.tc-item-ops.wrap > view:nth-child(even) { margin-left: 18rpx; }

/* 明细 */
.records {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(235, 225, 205, 0.10);
}
.rec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 66rpx;
  font-size: 23rpx;
  border-bottom: 1rpx solid rgba(235, 225, 205, 0.06);
}
.rec-opt { color: #cfc9bd; flex: 1; min-width: 0; }
.rec-time { color: #5f5b54; font-size: 21rpx; font-family: ui-monospace, Menlo, monospace; }
.rec-empty {
  font-size: 22rpx;
  color: #5f5b54;
  padding: 20rpx 0;
  text-align: center;
}
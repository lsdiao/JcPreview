.logo-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.logo-box {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  background-color: #0d0d13;
  border: 1rpx dashed rgba(235, 225, 205, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
}
.logo-box image { width: 100%; height: 100%; }
.logo-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #5f5b54;
  font-size: 40rpx;
}
.logo-ph-t { font-size: 20rpx; margin-top: 6rpx; }
.logo-tip {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  font-size: 21rpx;
  color: #5f5b54;
  line-height: 1.8;
}

.fl-label {
  font-size: 24rpx;
  color: #8f8a80;
  letter-spacing: 1rpx;
  margin: 26rpx 4rpx 14rpx;
}
.mt { margin-top: 28rpx; }
.hint {
  font-size: 21rpx;
  color: #5f5b54;
  line-height: 1.9;
  margin-top: 20rpx;
}

.app-row { display: flex; align-items: center; }
.app-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #241d12, #14110c);
  border: 1rpx solid rgba(201, 162, 107, 0.42);
  color: #e7d2a4;
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 700;
}
.app-logo image { width: 100%; height: 100%; }
.app-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}
.app-info .tc-item-meta { word-break: break-all; }
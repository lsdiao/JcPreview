.stat {
  display: flex;
  margin-bottom: 26rpx;
}
.stat-c {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  border-radius: 24rpx;
  background-color: #16161d;
  border: 1rpx solid rgba(235, 225, 205, 0.10);
}
.stat-c + .stat-c { margin-left: 18rpx; }
.stat-n {
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 800;
  color: #efe9dc;
}
.stat-n.is-gold { color: #e7d2a4; }
.stat-l {
  font-size: 21rpx;
  color: #8f8a80;
  margin-top: 10rpx;
  letter-spacing: 2rpx;
}

.fl-label {
  font-size: 24rpx;
  color: #8f8a80;
  letter-spacing: 1rpx;
  margin: 26rpx 4rpx 14rpx;
}
.fl-label:first-child { margin-top: 0; }
.mt { margin-top: 26rpx; }

.hint {
  font-size: 21rpx;
  color: #5f5b54;
  line-height: 1.9;
  margin-top: 20rpx;
}

.code {
  font-size: 34rpx;
  font-weight: 700;
  color: #e7d2a4;
  letter-spacing: 4rpx;
}
.adm-cell {
  background-color: #16161d;
  border: 1rpx solid rgba(235, 225, 205, 0.10);
  border-radius: 28rpx;
  padding: 34rpx 28rpx 30rpx;
}
.adm-cell-hover {
  transform: scale(0.96);
}
.adm-ic {
  color: #c9a26b;
  font-size: 46rpx;
  line-height: 1;
}
.adm-name {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-top: 22rpx;
}
.adm-desc {
  font-size: 21rpx;
  color: #5f5b54;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

.foot {
  text-align: center;
  font-size: 21rpx;
  color: #5f5b54;
  margin-top: 56rpx;
  font-family: ui-monospace, Menlo, monospace;
  word-break: break-all;
  padding: 0 20rpx;
}
.foot-tip {
  text-align: center;
  font-size: 20rpx;
  color: #454239;
  margin-top: 14rpx;
  line-height: 1.8;
  padding: 0 20rpx;
}
/* ---------- 顶部新建按钮 ---------- */
.bar {
  display: flex;
  margin-bottom: 28rpx;
}
.bar-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  color: #231a0c;
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.bar-btn + .bar-btn { margin-left: 20rpx; }
.bar-btn.is-ghost {
  background: transparent;
  border: 1rpx solid rgba(201, 162, 107, 0.5);
  color: #e7d2a4;
  font-weight: 600;
}
.bar-txt { margin-left: 12rpx; }

/* ---------- 列表项 ---------- */
.ci {
  display: flex;
}
.ci-thumb {
  position: relative;
  width: 180rpx;
  height: 122rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background-color: #222228;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ci-thumb image { width: 100%; height: 100%; }
.ci-thumb .is-ph { color: #454239; font-size: 44rpx; }
.ci-type {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.6);
  border: 1rpx solid rgba(231, 210, 164, 0.45);
  color: #e7d2a4;
  font-size: 18rpx;
}
.ci-main {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}
.ci-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}
.ci-tags .tc-tag { margin-right: 12rpx; margin-bottom: 8rpx; }

/* ---------- 操作按钮 ---------- */
.ops {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(235, 225, 205, 0.10);
}
.op {
  width: calc((100% - 36rpx) / 3);
  height: 68rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  border: 1rpx solid rgba(235, 225, 205, 0.14);
  color: #8f8a80;
  font-size: 24rpx;
}
.op:nth-child(3n-1) { margin: 0 18rpx 14rpx; }
.op.is-key { color: #e7d2a4; border-color: rgba(201, 162, 107, 0.5); }
.op.is-danger { color: #d98a77; border-color: rgba(224, 104, 79, 0.35); }

.foot-tip {
  text-align: center;
  font-size: 20rpx;
  color: #454239;
  line-height: 1.9;
  margin-top: 30rpx;
  padding: 0 20rpx;
}

/* ---------- 编辑面板 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 100;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  height: 88vh;
  display: flex;
  flex-direction: column;
  background-color: #12121a;
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  border-top: 1rpx solid rgba(201, 162, 107, 0.35);
}
.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx 22rpx;
  border-bottom: 1rpx solid rgba(235, 225, 205, 0.10);
}
.sheet-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #e7d2a4;
}
.sheet-close { font-size: 36rpx; color: #8f8a80; }
.sheet-body {
  flex: 1;
  min-height: 0;
  padding: 10rpx 36rpx 0;
}
.sheet-ft {
  display: flex;
  padding: 22rpx 36rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(235, 225, 205, 0.10);
}
.ft-btn { flex: 1; }
.ft-btn + .ft-btn { margin-left: 20rpx; }
.sheet-safe { height: 60rpx; }

/* 表单字段 */
.fl-label {
  font-size: 24rpx;
  color: #8f8a80;
  letter-spacing: 1rpx;
  margin: 28rpx 4rpx 14rpx;
}
.fl-label .req { color: #d98a77; font-size: 21rpx; margin-left: 8rpx; }
.fl-label:first-child { margin-top: 20rpx; }

.sec-t {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #c9c4b8;
  margin: 48rpx 4rpx 6rpx;
}
.sec-t::before {
  content: "";
  width: 6rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  margin-right: 16rpx;
}

.hint {
  font-size: 21rpx;
  color: #5f5b54;
  line-height: 1.9;
  margin: 20rpx 4rpx 0;
}

/* 类型切换 */
.seg {
  display: flex;
  background-color: #0d0d13;
  border: 1rpx solid rgba(235, 225, 205, 0.16);
  border-radius: 18rpx;
  padding: 6rpx;
}
.seg-i {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #8f8a80;
  letter-spacing: 1rpx;
}
.seg-i.on {
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  color: #231a0c;
  font-weight: 700;
}

/* 封面 */
.cover-row { display: flex; align-items: flex-start; }
.cover-box {
  width: 320rpx;
  height: 180rpx;
  border-radius: 18rpx;
  overflow: hidden;
  flex-shrink: 0;
  background-color: #0d0d13;
  border: 1rpx dashed rgba(235, 225, 205, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-box image { width: 100%; height: 100%; }
.cover-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #5f5b54;
  font-size: 40rpx;
}
.cover-ph-t { font-size: 21rpx; margin-top: 8rpx; }
.cover-tip {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  font-size: 21rpx;
  color: #5f5b54;
  line-height: 1.8;
}

.body-ta { min-height: 300rpx; }

/* 配图九宫格 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
}
.img-cell {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #222228;
}
.img-cell image { width: 100%; height: 100%; }
.img-cell.is-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #0d0d13;
  border: 1rpx dashed rgba(235, 225, 205, 0.24);
  color: #5f5b54;
  font-size: 52rpx;
}
.img-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  color: #e0684f;
  font-size: 28rpx;
  border-bottom-left-radius: 16rpx;
}

/* 开关行 */
.sw-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  padding: 0 4rpx;
  border-bottom: 1rpx solid rgba(235, 225, 205, 0.10);
}
.sw-name { font-size: 27rpx; }
.sw-desc { font-size: 21rpx; color: #5f5b54; margin-top: 8rpx; }
.fl-label {
  font-size: 24rpx;
  color: #8f8a80;
  letter-spacing: 2rpx;
  margin: 20rpx 0 12rpx;
}

.qrcode-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 400rpx;
  border: 2rpx dashed rgba(235, 225, 205, 0.2);
  border-radius: 20rpx;
  background-color: #0d0d13;
  position: relative;
}
.qrcode-ic {
  font-size: 80rpx;
  color: #5f5b54;
  margin-bottom: 16rpx;
}
.qrcode-tip {
  font-size: 24rpx;
  color: #5f5b54;
  letter-spacing: 2rpx;
}
.qrcode-img {
  width: 320rpx;
  height: 320rpx;
  border-radius: 16rpx;
}
.qrcode-replace {
  position: absolute;
  bottom: 20rpx;
  font-size: 22rpx;
  color: #c9a26b;
  letter-spacing: 2rpx;
}

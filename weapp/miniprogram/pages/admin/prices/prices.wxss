/* ---------- 顶部操作 ---------- */
.bar {
  display: flex;
  margin-bottom: 26rpx;
}
.bar-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  color: #231a0c;
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.bar-btn + .bar-btn { margin-left: 20rpx; }
.bar-btn.is-ghost {
  background: transparent;
  border: 1rpx solid rgba(201, 162, 107, 0.5);
  color: #e7d2a4;
  font-weight: 600;
}
.bar-txt { margin-left: 12rpx; }

/* ---------- 表单 ---------- */
.fl-label {
  font-size: 24rpx;
  color: #8f8a80;
  letter-spacing: 1rpx;
  margin: 26rpx 4rpx 14rpx;
}
.fl-label .req { color: #d98a77; font-size: 21rpx; margin-left: 8rpx; }

.two { display: flex; }
.two-c { flex: 1; min-width: 0; }
.two-c + .two-c { margin-left: 20rpx; }

.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.chip {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 12rpx;
  font-size: 23rpx;
  color: #a39e93;
  border: 1rpx solid rgba(235, 225, 205, 0.16);
}

.price-row { display: flex; }
.price-c { flex: 1; min-width: 0; }
.price-c + .price-c { margin-left: 16rpx; }
.price-lab {
  font-size: 21rpx;
  color: #8f8a80;
  text-align: center;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}
.price-in { text-align: center; font-size: 30rpx; color: #e7d2a4; }

.mt { margin-top: 22rpx; }

/* 图片九宫格 */
.img-grid { display: flex; flex-wrap: wrap; }
.img-cell {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #222228;
}
.img-cell image { width: 100%; height: 100%; }
.img-cell.is-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #0d0d13;
  border: 1rpx dashed rgba(235, 225, 205, 0.24);
  color: #5f5b54;
  font-size: 52rpx;
}
.img-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  color: #e0684f;
  font-size: 28rpx;
  border-bottom-left-radius: 16rpx;
}

.sw-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid rgba(235, 225, 205, 0.10);
}
.sw-name { font-size: 27rpx; }
.sw-desc { font-size: 21rpx; color: #5f5b54; margin-top: 8rpx; }

.form-ops { display: flex; margin-top: 28rpx; }
.fop { flex: 1; }
.fop + .fop { margin-left: 20rpx; }

/* ---------- 搜索 ---------- */
.search {
  display: flex;
  align-items: center;
  margin: 26rpx 0 20rpx;
  height: 84rpx;
  padding: 0 26rpx;
  border-radius: 18rpx;
  background-color: #16161d;
  border: 1rpx solid rgba(235, 225, 205, 0.12);
  color: #5f5b54;
}
.search .cuIcon-search { font-size: 32rpx; margin-right: 16rpx; }
.search-input { flex: 1; min-width: 0; height: 84rpx; font-size: 26rpx; color: #efe9dc; }

/* ---------- 列表项 ---------- */
.pi { display: flex; align-items: center; flex: 1; min-width: 0; }
.pi-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background-color: #222228;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pi-thumb image { width: 100%; height: 100%; }
.pi-thumb .is-ph { color: #454239; font-size: 40rpx; }
.pi-main { flex: 1; min-width: 0; margin-left: 20rpx; }

/* 操作按钮换行两列 */
.tc-item-ops.wrap {
  flex-wrap: wrap;
}
.tc-item-ops.wrap > view {
  flex: none;
  width: calc((100% - 18rpx) / 2);
  margin-left: 0;
  margin-bottom: 16rpx;
}
.tc-item-ops.wrap > view:nth-child(even) { margin-left: 18rpx; }

.foot-tip {
  text-align: center;
  font-size: 20rpx;
  color: #454239;
  line-height: 1.9;
  margin-top: 30rpx;
  padding: 0 20rpx;
}
.home-head {
  padding: 24rpx 36rpx 34rpx;
  border-bottom: 1rpx solid rgba(235, 225, 205, 0.10);
}
.brand {
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}
.brand-en {
  font-size: 19rpx;
  letter-spacing: 4rpx;
  color: #c9a26b;
  margin-top: 10rpx;
}

.feed {
  padding: 32rpx 32rpx 20rpx;
}
.feed-item {
  background-color: #16161d;
  border: 1rpx solid rgba(235, 225, 205, 0.10);
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 36rpx;
}
.feed-item-hover {
  transform: scale(0.985);
}

.thumb image {
  opacity: 0.92;
}
.tdim {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.55) 100%);
}

.pin-tag {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  height: 42rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  color: #1d1608;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.play {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.play-ic {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 10, 14, 0.4);
  border: 1rpx solid rgba(231, 210, 164, 0.65);
  color: #e7d2a4;
  font-size: 44rpx;
}

.dur {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(231, 210, 164, 0.4);
  background: rgba(0, 0, 0, 0.5);
  color: #e7d2a4;
  font-size: 21rpx;
  font-family: ui-monospace, Menlo, monospace;
}

.kind {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(231, 210, 164, 0.4);
  background: rgba(0, 0, 0, 0.5);
  color: #e7d2a4;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.info {
  padding: 26rpx 30rpx 30rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}
.meta {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #8f8a80;
  line-height: 1.7;
}
.src {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  font-size: 21rpx;
  color: #8f8a80;
  letter-spacing: 1rpx;
}
.src .dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #5f5b54;
  margin-right: 12rpx;
}

/* ---------- 专属顾问悬浮按钮 ---------- */
.consultant-fab {
  position: fixed;
  right: 24rpx;
  bottom: 160rpx;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 110rpx;
}
.consultant-fab-ic {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #231a0c;
  font-size: 42rpx;
  box-shadow: 0 8rpx 24rpx rgba(201, 162, 107, 0.35);
}
.consultant-fab-text {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #e7d2a4;
  letter-spacing: 1rpx;
  background: rgba(12, 12, 17, 0.85);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(201, 162, 107, 0.3);
}

/* ---------- 专属顾问弹框 ---------- */
.consultant-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 80rpx;
}
.consultant-modal {
  width: 100%;
  background: linear-gradient(160deg, #2b2416 0%, #191510 60%, #100e0a 100%);
  border: 1rpx solid rgba(201, 162, 107, 0.4);
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  position: relative;
  text-align: center;
}
.consultant-modal-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  color: #e7d2a4;
  letter-spacing: 8rpx;
  margin-bottom: 8rpx;
}
.consultant-modal-name {
  font-size: 24rpx;
  color: #c9a26b;
  letter-spacing: 4rpx;
  margin-bottom: 28rpx;
}
.consultant-modal-qrcode {
  width: 380rpx;
  height: 380rpx;
  border-radius: 20rpx;
  background-color: #fff;
  padding: 16rpx;
}
.consultant-modal-tip {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #8f8a80;
  letter-spacing: 2rpx;
}
.consultant-modal-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5f5b54;
  font-size: 28rpx;
}
.gallery {
  position: relative;
  width: 100%;
  height: 750rpx;
  background-color: #16161d;
}
.swiper { width: 100%; height: 100%; }
.swiper image { width: 100%; height: 100%; }
.gallery-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #454239;
  font-size: 90rpx;
}
.counter {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  height: 46rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #e7d2a4;
  font-size: 21rpx;
  font-family: ui-monospace, Menlo, monospace;
  display: flex;
  align-items: center;
}

.body { padding: 34rpx 36rpx 40rpx; }
.title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.price-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 28rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(130deg, rgba(43, 36, 22, 0.9), rgba(16, 14, 10, 0.9));
  border: 1rpx solid rgba(201, 162, 107, 0.35);
}
.pb-label {
  font-size: 22rpx;
  color: #c9a26b;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}
.pb-num { font-size: 62rpx; line-height: 1; }
.pb-num .unit { font-size: 22rpx; margin-left: 6rpx; }

.kvs {
  margin-top: 32rpx;
  border-top: 1rpx solid rgba(235, 225, 205, 0.10);
}
.kv {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid rgba(235, 225, 205, 0.10);
}
.kv .k {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8f8a80;
  letter-spacing: 1rpx;
}
.kv .v { font-size: 26rpx; color: #cfc9bd; }
.kv .cuIcon-copy { font-size: 26rpx; margin-left: 10rpx; }

.desc {
  font-size: 27rpx;
  color: #cfc9bd;
  line-height: 1.95;
}

.note {
  margin-top: 44rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(235, 225, 205, 0.10);
  font-size: 21rpx;
  color: #5f5b54;
  line-height: 1.9;
}
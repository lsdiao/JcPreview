.head {
  padding: 30rpx 36rpx 24rpx;
}
.head-t {
  font-family: "Songti SC", "STSong", serif;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.head-s {
  font-size: 22rpx;
  color: #8f8a80;
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

/* 品牌小程序横滑 */
.apps {
  white-space: nowrap;
  padding: 8rpx 24rpx 4rpx;
}
.app {
  display: inline-block;
  width: 168rpx;
  vertical-align: top;
  text-align: center;
  margin: 0 12rpx 16rpx;
}
.app-hover { opacity: 0.7; }
.app-logo {
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: linear-gradient(135deg, #241d12, #14110c);
  border: 1rpx solid rgba(201, 162, 107, 0.42);
  color: #e7d2a4;
  font-family: "Songti SC", "STSong", serif;
  font-size: 40rpx;
  font-weight: 700;
}
.app-logo image { width: 100%; height: 100%; }
.app-name {
  font-size: 21rpx;
  color: #a39e93;
  margin-top: 14rpx;
  letter-spacing: 1rpx;
}

/* 搜索 */
.search {
  display: flex;
  align-items: center;
  margin: 20rpx 32rpx 0;
  height: 84rpx;
  padding: 0 26rpx;
  border-radius: 18rpx;
  background-color: #16161d;
  border: 1rpx solid rgba(235, 225, 205, 0.12);
  color: #5f5b54;
}
.search .cuIcon-search { font-size: 32rpx; margin-right: 16rpx; }
.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  font-size: 26rpx;
  color: #efe9dc;
}

/* 分类 */
.cats {
  white-space: nowrap;
  padding: 24rpx 32rpx 6rpx;
}
.cat {
  display: inline-block;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #8f8a80;
  border: 1rpx solid rgba(235, 225, 205, 0.12);
  letter-spacing: 1rpx;
}
.cat.on {
  color: #231a0c;
  font-weight: 700;
  border-color: transparent;
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
}

/* 产品卡 */
.plist { padding: 24rpx 32rpx 0; }
.pcard {
  display: flex;
  padding: 22rpx;
  margin-bottom: 22rpx;
  background-color: #16161d;
  border: 1rpx solid rgba(235, 225, 205, 0.10);
  border-radius: 28rpx;
}
.pcard-hover { transform: scale(0.985); }
.pimg {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  background-color: #222228;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pimg image { width: 100%; height: 100%; }
.pimg .is-ph { color: #454239; font-size: 52rpx; }
.pinfo {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
}
.pname {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
}
.pspec {
  font-size: 22rpx;
  color: #8f8a80;
  margin-top: 10rpx;
}
.pno {
  font-size: 21rpx;
  color: #5f5b54;
  margin-top: 8rpx;
}
.prow {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tc-price { font-size: 40rpx; }
.tc-price .unit { font-size: 21rpx; margin-left: 4rpx; }

.tip {
  text-align: center;
  font-size: 21rpx;
  color: #454239;
  padding: 20rpx 40rpx 0;
  line-height: 1.8;
}
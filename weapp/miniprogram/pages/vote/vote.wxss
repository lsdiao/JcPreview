.head { padding: 32rpx 36rpx 26rpx; }
.head-t {
  font-family: "Songti SC", "STSong", serif;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.head-s {
  font-size: 22rpx;
  color: #8f8a80;
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

.vlist { padding: 6rpx 32rpx 0; }
.vcard {
  background-color: #16161d;
  border: 1rpx solid rgba(235, 225, 205, 0.10);
  border-radius: 30rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}
.vcard-hover { transform: scale(0.985); }

.vthumb {
  position: relative;
  width: 100%;
  height: 340rpx;
}
.vthumb image { width: 100%; height: 100%; display: block; opacity: 0.94; }
.vstate {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  height: 44rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  border-radius: 10rpx;
  background: rgba(0, 0, 0, 0.55);
  border: 1rpx solid rgba(143, 138, 128, 0.5);
  color: #8f8a80;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.vstate.on {
  background: linear-gradient(135deg, #ecd9ac 0%, #c9a26b 55%, #a97f4c 100%);
  border-color: transparent;
  color: #1d1608;
}

.vbody { padding: 26rpx 30rpx 30rpx; }
.vtitle {
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.5;
}
.vintro {
  font-size: 24rpx;
  color: #8f8a80;
  line-height: 1.75;
  margin-top: 14rpx;
}
.vmeta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #5f5b54;
}
.vm-num {
  color: #e7d2a4;
  font-family: ui-monospace, Menlo, monospace;
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 6rpx;
}
.vm-lab { margin-right: 4rpx; }
.vmeta .dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #454239;
  margin: 0 14rpx;
}

.vmine {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(235, 225, 205, 0.10);
  color: #7fd8a4;
  font-size: 22rpx;
}
.vmine .cuIcon-roundcheckfill { font-size: 28rpx; margin-right: 10rpx; }
.vmine-txt { color: #a39e93; }
.stage {
  width: 100%;
  height: 422rpx;
  background-color: #000;
}

.stage-fallback {
  position: relative;
  width: 100%;
  height: 422rpx;
  background-color: #000;
  overflow: hidden;
}
.stage-fallback image {
  width: 100%;
  height: 100%;
  opacity: 0.42;
}
.fb-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.fb-ic {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(231, 210, 164, 0.4);
  color: #e7d2a4;
  font-size: 44rpx;
  margin-bottom: 24rpx;
}
.fb-text {
  font-size: 27rpx;
  color: #efe9dc;
  letter-spacing: 2rpx;
}
.fb-sub {
  font-size: 22rpx;
  color: #8f8a80;
  margin-top: 12rpx;
}

.cover {
  width: 100%;
  height: 422rpx;
  display: block;
}

.body {
  padding: 36rpx 36rpx 40rpx;
}
.title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: 1rpx;
}
.meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8f8a80;
  letter-spacing: 1rpx;
}
.meta .dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #5f5b54;
  margin: 0 14rpx;
}
.tag-lite {
  color: #c9a26b;
  border: 1rpx solid rgba(201, 162, 107, 0.4);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
}

.summary {
  margin-top: 26rpx;
  font-size: 26rpx;
  color: #a39e93;
  line-height: 1.9;
}

.para {
  margin-top: 26rpx;
  font-size: 28rpx;
  color: #cfc9bd;
  line-height: 1.95;
}
.inline-img {
  width: 100%;
  margin-top: 28rpx;
  border-radius: 20rpx;
  display: block;
}

.act {
  margin-top: 40rpx;
}
.act-btn {
  width: 100%;
  height: 84rpx;
}
.act-txt {
  margin-left: 14rpx;
}

.note {
  margin-top: 36rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(235, 225, 205, 0.10);
  font-size: 21rpx;
  color: #5f5b54;
  line-height: 1.9;
}